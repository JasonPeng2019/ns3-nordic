#!/usr/bin/env python3
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parents[1]
CHUNK_RE = re.compile(r"/chunks/ch(\d\d)/")
INC_RE = re.compile(r'^\s*#\s*include\s+"([^"]+)"')

errors = []
index = {}
for p in ROOT.glob("model/chunks/ch*/*"):
    if p.is_file():
        m = CHUNK_RE.search(str(p))
        if m:
            index[p.name] = int(m.group(1))

for p in ROOT.glob("model/chunks/ch*/*"):
    if not p.is_file() or p.suffix not in {".h", ".cc", ".c"}:
        continue
    m = CHUNK_RE.search(str(p))
    if not m:
        continue
    own = int(m.group(1))
    txt = p.read_text(errors="ignore")
    for line in txt.splitlines():
        mi = INC_RE.match(line)
        if not mi:
            continue
        name = pathlib.Path(mi.group(1)).name
        tgt = index.get(name)
        if tgt is not None and tgt > own:
            errors.append(f"{p.relative_to(ROOT)} includes future chunk header {name}")

if errors:
    print("Chunk boundary validation failed:")
    for e in errors:
        print(f" - {e}")
    sys.exit(1)

print("Chunk boundary validation passed")
